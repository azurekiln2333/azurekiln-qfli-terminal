# A separate random secret shared only with QFLI (32-256 printable ASCII bytes).
# Use the same value in every business replica's node entry for this node.
QFLI_TERMINAL_SECRET=
# Sandbox toolchain image pulled into the dedicated rootless engine. The
# executor pins its immutable image ID after validating labels and entrypoint.
# Production never builds this image on the server.
QFLI_TERMINAL_IMAGE=docker.cnb.cool/azurekiln/azurekiln-qfli-terminal/sandbox:3
# Executor service image. Used by docker-compose.yaml image selection only.
QFLI_TERMINAL_SERVICE_IMAGE=docker.cnb.cool/azurekiln/azurekiln-qfli-terminal:latest
# Fallback registries (GitHub Packages / GitLab, see deploy/ci-platforms.md):
# QFLI_TERMINAL_IMAGE=ghcr.io/azurekiln2333/azurekiln-qfli-terminal/sandbox:3
# QFLI_TERMINAL_SERVICE_IMAGE=ghcr.io/azurekiln2333/azurekiln-qfli-terminal:latest
# QFLI_TERMINAL_IMAGE=registry.gitlab.com/azurekiln-team/azurekiln-qfli-terminal/sandbox:3
# QFLI_TERMINAL_SERVICE_IMAGE=registry.gitlab.com/azurekiln-team/azurekiln-qfli-terminal:latest
# Host UID of the dedicated qfli-runner account (id -u qfli-runner).
QFLI_RUNNER_HOST_UID=
# Loopback host port the executor is published on: 127.0.0.1:<port>:3101.
# The executor always listens on the fixed container port 3101, so the internal
# health check and verify-runtime entry point never change. The business URL
# must use the same host port. The installer persists --port here for reruns.
# QFLI_TERMINAL_HOST_PORT=3101
# Optional image auto-update. The watchtower service lives in the auto-update
# profile and does not start unless this line names that profile. Leave both
# the profile and WATCHTOWER_POLL_INTERVAL unset to run without an updater.
# COMPOSE_PROFILES=auto-update
# WATCHTOWER_POLL_INTERVAL=600
# Auto-update restarts the executor and destroys the active session.
# Set QFLI_TERMINAL_AUTO_UPDATE=false on nodes that must keep long commands
# until an explicit drain; it labels the executor image for the updater only.
# QFLI_TERMINAL_AUTO_UPDATE=true
# Fixed small-host budgets live in src/config.js: 1 session, 1 operation,
# 8 FIFO waiting requests, 20-second maximum wait, 120-second idle expiry.
# The user.slice limits cover Docker, gVisor, the executor and the sandbox.
# DEBIAN_MIRROR is a Docker build argument; it is not a runner environment option.
# Legacy host-service mode only: set these for the dedicated qfli-runner account.
# DOCKER_HOST=unix:///run/user/UID/docker.sock
# XDG_RUNTIME_DIR=/run/user/UID
